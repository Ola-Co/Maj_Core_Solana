      "name": "SignatureRecord",
      "docs": [
        "Existence of this PDA means `signer` has approved `maj_tx`.",
        "Seeds: [b\"sig\", maj_tx.as_ref(), signer.as_ref()]",
        "Created by sign_transaction; closed (rent returned) by revoke_signature."
      ],
      "type": {
        "kind": "struct",
        "fields": [
