          }
        ]
      }
    },
    {
      "name": "MajInstance",
      "docs": [
        "The core multisig wallet PDA.  Each unique Maj instance is identified",
        "by its human-readable name.  This account IS the treasury — it holds SOL."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "name",
            "docs": [
              "Human-readable identifier (max 64 UTF-8 bytes)."
            ],
            "type": "string"
          },
          {
            "name": "admins",
            "docs": [
              "Ordered list of admin pubkeys (kept in sync with AdminRecord PDAs)."
            ],
            "type": {
              "vec": "pubkey"
            }
          },
          {
            "name": "sigs_required",
            "docs": [
              "Minimum signatures needed to execute a transaction (always >= 2)."
            ],
            "type": "u64"
          },
          {
            "name": "tx_count",
            "docs": [
              "Monotonically-increasing counter used as the MajTransaction PDA seed."
            ],
            "type": "u64"
          },
          {
            "name": "bump",
            "docs": [
              "Canonical bump for the PDA derived from [b\"maj_instance\", name.as_bytes()]."
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "MajNameRecord",
      "docs": [
        "Reserves a name so no two instances share the same identifier.",
        "Seeds: [b\"maj_name\", name.as_bytes()]"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "maj_instance",
            "type": "pubkey"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "MajRegistry",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "total_instances",
            "type": "u64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "MajTransaction",
      "docs": [
        "A proposed (and potentially executed) multisig transaction.",
        "Seeds: [b\"maj_tx\", maj_instance.as_ref(), tx_index.to_le_bytes()]",
        "",
        "The account is initialised with minimum space; data/account_metas are",
        "Borsh-variable so the account is realloced if the proposal carries a",
        "non-empty payload."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "maj_instance",
            "type": "pubkey"
          },
          {
            "name": "tx_index",
            "type": "u64"
          },
          {
            "name": "to",
            "docs": [
              "Destination pubkey.  For SOL transfers this is the recipient; for",
              "CPI calls it mirrors the program_id field."
            ],
            "type": "pubkey"
          },
          {
            "name": "value",
            "docs": [
              "Lamports to transfer (0 for pure CPI calls)."
            ],
            "type": "u64"
          },
          {
            "name": "proposed_by",
            "type": "pubkey"
          },
          {
            "name": "active",
            "type": "bool"
          },
          {
            "name": "executed",
            "type": "bool"
          },
          {
            "name": "num_signatures",
            "docs": [
              "u32 (not u8) so large admin sets can all sign."
            ],
            "type": "u32"
          },
          {
            "name": "program_id",
            "docs": [
              "None = SOL transfer; Some(pid) = CPI call to pid."
            ],
            "type": {
              "option": "pubkey"
            }
          },
          {
            "name": "data",
            "docs": [
              "Borsh-encoded instruction data for CPI calls (empty for SOL transfer)."
            ],
            "type": "bytes"
          },
          {
            "name": "account_metas",
            "docs": [
              "Ordered accounts for the CPI call."
            ],
            "type": {
              "vec": {
                "defined": {
                  "name": "SerializedAccountMeta"
                }
              }
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "SerializedAccountMeta",
      "docs": [
        "A compact, borsh-serializable representation of an account meta entry",
        "used when encoding CPI payloads inside a MajTransaction."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "pubkey",
            "type": "pubkey"
          },
          {
            "name": "is_signer",
            "type": "bool"
          },
          {
            "name": "is_writable",
            "type": "bool"
          }
        ]
      }
    },
